# Deployment configuration — copy to deploy.config.sh and fill in your values.
# deploy.config.sh is gitignored (contains credentials).

# ── Release archives ─────────────────────────────────────────────────────────
# install.sh and upgrade.sh download nothing: the FTP/SFTP server that scripts/build.py
# uploads to runs on this machine, and they unpack the newest backend-*.zip and
# frontend-*.zip from these directories (newest by modification time, after
# checking that it is a whole zip). Absolute paths on THIS disk - for FTP the FTP
# user's root plus the [ftp.paths] entry of build.config.toml, for SFTP its
# [sftp.paths] entry. The user running the scripts (root) must be able to read them.
# The old FTP_HOST / FTP_USER / FTP_PASS / FTP_*_PATH settings are no longer used.
BACKEND_RELEASES_DIR="/home/ftp-user/releases/backend"
FRONTEND_RELEASES_DIR="/home/ftp-user/releases/frontend"

# ── Application ───────────────────────────────────────────────────────────────
# If this app's backend/.env defines UPLOADS_DIR, upgrade.sh reads it from
# there automatically and preserves that directory across the backend/ wipe
# on every deploy, the same way it already preserves .env. No separate
# config is needed here for that.
INSTALL_DIR="/srv/apps/auth"        # absolute path; scripts run from here
DOMAIN="auth.withfbraun.com"
BACKEND_PORT=8002
APP_USER="app-auth"
APP_GROUP="app-services"
APP_SERVICE_NAME="app-auth.service"
APP_SERVICE_DESC="Authentication with FBraun"
FRONTEND_URL="https://"
BACKEND_URL="http://"

# ── nginx ─────────────────────────────────────────────────────────────────────
NGINX_SITES_CONF="/etc/nginx/conf.d"

# ── Certbot ───────────────────────────────────────────────────────────────────
CERTBOT_DOMAINS_FILE="/srv/scripts/certbot/domains.txt"
CERTBOT_REFRESH_SCRIPT="/srv/scripts/certbot/refresh_cert.sh"
