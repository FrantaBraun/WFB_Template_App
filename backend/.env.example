# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wfb_freelancer_db

# ─── Authorization (auth.withfbraun.com) ─────────────────────────────────────
AUTH_URL=https://auth.withfbraun.com

# API klíč aplikace — vytvoří se v auth.withfbraun.com přes
# POST /api/integrator/apps/{app_id}/clients (zobrazí se jen jednou).
# Bez něj funguje jen refresh/logout/me; register a login vyžadují X-Api-Key.
AUTH_API_KEY=

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Soubory nahrané přes moduly (např. obrázky článků z modulu articles);
# každý modul si v něm vytvoří vlastní podsložku. Lokálně stačí výchozí.
# V produkci musí mířit mimo backend/ - scripts/upgrade.sh při každém
# nasazení backend/ smaže a vytvoří znovu (zachová jen .env).
UPLOADS_DIR=./uploads

# ─── Logging ─────────────────────────────────────────────────────────────────
LOGGING_DIR=./logs
LOGGING_FILENAME=app.log
LOGGING_DAYS_HISTORY=5
LOGGING_MESSAGE_FORMAT=%(asctime)s %(levelname)s\t- %(module)s.%(funcName)s: %(message)s
LOGGING_LEVEL=INFO

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
# Set to true to skip actual sending (useful for development)
MAIL_SUPPRESS_SEND=false

# ─── Application ─────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000

# URL frontendu použitá v emailových odkazech (verify, reset).
# Pro více aplikací uveď tu, která obsluhuje tyto flows.
FRONTEND_URL=http://localhost:3000

# Pokud CORS řeší reverse proxy (nginx/traefik), nastav CORS_ENABLED=false.
# Zabrání duplicitním hlavičkám a není potřeba nic měnit při přidání nové app.
# Bearer tokeny fungují s Access-Control-Allow-Origin: * bez omezení.
CORS_ENABLED=true

# Ignorováno při CORS_ENABLED=false.
# Příklad pro více aplikací: ["https://app1.example.com", "https://app2.example.com"]
CORS_ORIGINS=["http://localhost:5173"]

# Adresa, na kterou chodí zprávy z modulu kontaktního formuláře
# (app/modules/kontaktni_formular). Vyžadováno, pokud je modul zapnutý -
# router s jasnou chybou selže, pokud je prázdné.
CONTACT_MAIL=
# Veřejné kontaktní údaje, které stránka kontaktu může zobrazit vedle
# formuláře - každý jen pokud je vyplněný. Odkazy musí být http(s) URL.
# Samotný CONTACT_MAIL se zobrazí jen při "show_email": true ve verzovaném
# backend/modules/kontaktni_formular.json. Víceřádková adresa: hodnotu dejte
# do uvozovek a řádky oddělte \n.
CONTACT_ADDRESS=
CONTACT_GITHUB_URL=
CONTACT_LINKEDIN_URL=

# Poskytovatel webu pro právní stránky (app/modules/freelancer): zásady ochrany
# osobních údajů, podmínky a cookies ho uvádějí jako správce. Dokud nejsou
# vyplněné JMÉNO, IČO, ADRESA a E-MAIL, ukazují stránky upozornění, že údaje
# chybí. Po úpravě je potřeba backend restartovat.
PROVIDER_NAME=
PROVIDER_ICO=
PROVIDER_DIC=
# true, pokud je poskytovatel plátcem DPH
PROVIDER_VAT_PAYER=false
PROVIDER_ADDRESS=
# Jak je poskytovatel zapsán ve veřejném rejstříku, jedna věta pro každý jazyk
PROVIDER_REGISTRATION_CS=
PROVIDER_REGISTRATION_EN=
PROVIDER_EMAIL=
PROVIDER_PHONE=
# Volitelné: vlastní adresa pro žádosti o ochranu osobních údajů, web poskytovatele (http/https)
PROVIDER_DPO_EMAIL=
PROVIDER_WEB=
# Datum účinnosti právních textů, ve tvaru RRRR-MM-DD
PROVIDER_EFFECTIVE_FROM=
# Potvrzovací e-mail odesílateli (zapnutí, texty podle jazyka formuláře,
# výchozí jazyk) se NEnastavuje tady, ale ve verzovaném
# backend/modules/kontaktni_formular.json.

# Adresa, na kterou chodí upozornění na každou novou přihlášku z modulu
# registrací na události (app/modules/event_booking). Je-li prázdná, použije se
# CONTACT_MAIL; nejsou-li vyplněné obě, upozornění se jen zaloguje. Jazyk,
# texty a vypnutí upozornění / potvrzení přihlášenému jsou ve verzovaném
# backend/modules/event_booking.json. Odkaz na zrušení v e-mailech se skládá
# z FRONTEND_URL.
BOOKING_NOTIFY_MAIL=

# Schránka modulu ticketů (app/modules/tickets): odtud se každé
# TICKETS_POLL_SECONDS vteřin čtou nové požadavky a odpovědi zákazníků (IMAP,
# přečtené zprávy se označí jako přečtené). Je-li TICKETS_IMAP_HOST prázdné,
# schránka se nečte (ticket jde založit formulářem a kontaktním formulářem).
# TICKETS_POLL_SECONDS=0 vypne i periodické čtení (tlačítko "zkontrolovat
# poštu" funguje dál). TICKETS_MAILBOX_ADDRESS je adresa, na kterou mají
# chodit odpovědi - jde do Reply-To všech e-mailů modulu; je-li prázdná, použije
# se TICKETS_IMAP_USERNAME (je-li to adresa), jinak MAIL_FROM. Odesílá se
# přes běžné MAIL_* SMTP. Odpovědi se k ticketu přiřazují podle čísla v
# předmětu ([Ticket#100253]).
TICKETS_IMAP_HOST=
TICKETS_IMAP_PORT=993
TICKETS_IMAP_SSL=true
TICKETS_IMAP_USERNAME=
TICKETS_IMAP_PASSWORD=
TICKETS_IMAP_FOLDER=INBOX
TICKETS_POLL_SECONDS=120
TICKETS_MAILBOX_ADDRESS=

# Klíče pro modul platební brány Stripe (app/modules/stripe_payment_gate).
# STRIPE_SECRET_KEY je tajný klíč (sk_test_... / sk_live_...) z Stripe
# Dashboardu, STRIPE_WEBHOOK_SECRET je podpisový klíč (whsec_...) webhook
# endpointu mířícího na <APP_BASE_URL>/api/modules/stripe_payment_gate/webhook
# (lokálně: `stripe listen --forward-to localhost:8000/api/modules/stripe_payment_gate/webhook`).
# Oba jsou povinné, pokud je modul zapnutý. Návratové URL z platby se skládají
# z FRONTEND_URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Moduly (app/modules/) ────────────────────────────────────────────────────
# Zapnuté moduly se NEnastavují tady, ale v backend/modules.json (pole
# "enabled"), který je verzovaný v gitu - každá větev/aplikace tak nese svůj
# vlastní výběr modulů. Proměnná ENABLED_MODULES se už ignoruje.
